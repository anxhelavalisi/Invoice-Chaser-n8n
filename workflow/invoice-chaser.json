    {
      "parameters": {
        "jsCode": "// ---- Settings ----\nconst TODAY = '2026-10-11';   // vendos null për datën reale\nconst SOFT_MAX = 7;           // 1-7 ditë vonesë: kujtesë e butë\nconst FIRM_MAX = 30;          // 8-30 ditë: më e prerë, mbi 30: përfundimtare\nconst MIN_GAP = 7;            // mos e kujto më shpesh se çdo 7 ditë\n\nconst toDay = (s) => Math.floor(new Date(String(s).slice(0, 10) + 'T00:00:00Z').getTime() / 86400000);\nconst today = TODAY ? toDay(TODAY) : Math.floor(Date.now() / 86400000);\n\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (r.status === 'Paid') continue;\n\n  const daysLate = today - toDay(r.due_date);\n  if (daysLate <= 0) continue;                       // ende pa skaduar\n\n  if (r.last_reminder_date) {\n    const since = today - toDay(r.last_reminder_date);\n    if (since < MIN_GAP) continue;                   // u kujtua së fundmi\n  }\n\n  const tone = daysLate <= SOFT_MAX ? 'soft' : daysLate <= FIRM_MAX ? 'firm' : 'final';\n\n  out.push({ json: {\n    invoice_id: r.invoice_id,\n    client: r.client,\n    client_email: r.client_email,\n    amount: r.amount,\n    due_date: r.due_date,\n    days_late: daysLate,\n    tone,\n    reminder_number: Number(r.reminder_count || 0) + 1,\n    today_str: TODAY || new Date().toISOString().slice(0, 10),\n  }});\n}\nreturn out;"
      },
